{
  "name": "service-realtime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "test": "node ../api/node_modules/jest/bin/jest.js"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "<rootDir>/../../api/node_modules/ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "ts-node-dev": "^2.0.0",
    "prisma": "^5.10.0"
  }
}
