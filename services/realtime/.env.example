# Realtime service
# URL de la base de datos (la misma que usa services/api)
DATABASE_URL=postgresql://radiotaxi:radiotaxi@localhost:5432/radiotaxi

# Puerto del servicio de tiempo real
PORT=3002

# Secreto JWT: DEBE ser el mismo que services/api para validar los tokens.
# En producción, un valor aleatorio de >=32 caracteres (obligatorio).
JWT_SECRET=dev-insecure-secret

# CORS: orígenes permitidos separados por coma (dashboard, apps).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
